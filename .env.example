# ============================================================
# ClusterInte-lligence 环境变量模板
#
# 用法：
#   cp .env.example .env.local      # 然后把 CHANGE_ME 换成真实值
#
# 云服务器（低内存 / 尚未部署 Neo4j）请先读：
#   docs/云服务器部署与Neo4j接入.md
#
# .env.local 已被 .gitignore 忽略，永远不进入提交。
# 本模板只含占位值：禁止把真实密码或真实内网 IP 写进仓库。
# ============================================================

# ---------- Neo4j 连接 ----------
# 项目里有两条访问通道，但**只需要配 NEO4J_URI**：HTTP 地址会自动推导（7687 → 7474）。
#   • HTTP 事务端点（src/lib/neo4j.ts，零依赖 fetch）→ /api/topology/*、/api/analysis/gds
#   • Bolt 驱动（neo4j-driver）                     → /api/analysis/path、/api/analysis/neighbors
NEO4J_URI=bolt://localhost:7687

# 仅在反向代理 / 非默认端口 / HTTP 与 Bolt 不在同一主机时才需要显式指定
# NEO4J_HTTP_URL=http://localhost:7474

NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME

# NEO4J_DB 与 NEO4J_DATABASE 互为兜底（历史遗留两个键），填一个即可，都留最省心
NEO4J_DB=neo4j
NEO4J_DATABASE=neo4j

# 单次 Cypher 请求超时（毫秒）。库不可用时快速失败，避免页面一直转圈
NEO4J_TIMEOUT_MS=8000

# ---------- Python（/api/enrich 的 Enricher 管道会调用）----------
# Linux 服务器一般填 python3；Windows 填解释器绝对路径
PYTHON_BIN=python3

# ---------- 已知采集 / 汇聚 / 安全设备 IP ----------
# 用于识别「核心基础设施」节点，避免采集 hub 被误判为异常。
# 仓库内只有匿名占位（10.255.0.x）；真实值只写在本文件。
MONITOR_IPS=10.255.0.1,10.255.0.2,10.255.0.3
# 构建期会被 next build 内联进前端产物：改这个值必须重新 build
NEXT_PUBLIC_MONITOR_IPS=10.255.0.1,10.255.0.2,10.255.0.3

# ---------- 服务监听 ----------
PORT=5000
# 仅影响日志与 Next 的 hostname 认知；src/server.ts 的 listen() 绑定全部网卡
HOSTNAME=localhost

# ---------- Coze 平台部署标识（本地开发请留空 = 开发模式）----------
# COZE_PROJECT_ENV=PROD
